rules_version = '2';
// Firestore security rules for Red & Gold Golf (project chamigolf1).
// Paste into Firebase console > Firestore Database > Rules and press Publish.
// Players sign in with player codes (Authentication > Email/Password); anonymous guest accounts are the fallback.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMe(uid) { return request.auth != null && request.auth.uid == uid; }
    // The creator (admin tools: bans, analytics, gifts, removing scores): the creator's player-code account, by its uid.
    function isAdmin() { return request.auth != null && request.auth.uid == 'ehmuzxkmLXSu8oDLLcTBF0l1m2y2'; }
    // Only the creator's bans count: old automatic bans (auto == true) are ignored, so nobody stays locked out by them.
    function notBanned() { return request.auth != null && (!exists(/databases/$(database)/documents/bans/$(request.auth.uid))
      || get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.get('auto', false) == true); }
    // Names: 1-14 characters, and none of the worst words (the game also runs a much bigger filter before posting).
    function okName(n) { return n is string && n.size() > 0 && n.size() <= 14
      && !n.lower().matches('.*(fuck|shit|bitch|cunt|nigg|faggot|retard|whore|slut|penis|vagina|porn|nazi|hitler|dildo|pussy|rapist|molest|pedo|asshole|kkk).*'); }
    // Badges shown next to names. Creator, First Ace Ever and Creator's Pick are checked here so nobody can fake them.
    function okBadge(d, uid) {
      return !('badge' in d) || d.badge in ['ace', 'champ']
        || (d.badge == 'creator' && isAdmin())
        || (d.badge == 'gift' && exists(/databases/$(database)/documents/gifts/$(uid)))
        || (d.badge == 'firstace' && get(/databases/$(database)/documents/meta/firstAce).data.uid == uid);
    }
    // a score's time has to be close to now (no posting to other days by changing the device clock)
    // Daily Champion win count shown next to the trophy (optional)
    function okWins(d) { return !('wins' in d) || (d.wins is int && d.wins >= 0 && d.wins < 1000); }
    function recent(ms) { return ms is int && ms > request.time.toMillis() - 172800000 && ms < request.time.toMillis() + 172800000; }

    // Each golfer's saved progress (only they can read or write it; the creator can read it).
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow delete: if isMe(uid);
      // money check: your bank can never be more than the game has ever paid you (spending only takes money away)
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['data', 'name', 'coins', 'earned', 'updated'])
        && request.resource.data.data is string && request.resource.data.data.size() < 500000
        && request.resource.data.coins is number && request.resource.data.earned is number
        && request.resource.data.coins >= 0 && request.resource.data.coins <= request.resource.data.earned + 5000;
    }

    // Course leaderboards: one row per golfer (their best), all-time and per day.
    function okScore(uid) {
      let d = request.resource.data;
      return isMe(uid) && notBanned() && d.keys().hasOnly(['name', 'uid', 'rel', 'strokes', 'date', 'day', 't', 'badge', 'wins'])
        && d.uid == uid && okName(d.name) && okBadge(d, uid) && okWins(d)
        && d.rel is int && d.rel > -30 && d.rel < 300
        && d.strokes is int && d.strokes > 0 && d.strokes < 400
        && recent(d.date) && d.day is string && d.t == request.time;
    }
    match /courses/{cid}/scores/{uid} {
      allow read: if true;
      allow create: if okScore(uid);
      allow update: if okScore(uid) && request.resource.data.rel < resource.data.rel;
      allow delete: if isAdmin();
    }
    match /courses/{cid}/days/{day}/scores/{uid} {
      allow read: if true;
      allow create: if okScore(uid) && request.resource.data.day == day;
      allow update: if okScore(uid) && request.resource.data.day == day && request.resource.data.rel < resource.data.rel;
      allow delete: if isAdmin();
    }

    // ---- Spirit Day · Weekly Homeroom Cup (Oct 28 2026) ----
    // hrcup/{week}/scores/{uid}: each golfer's official best 18-hole round of the week. {week} = that week's Monday (YYYY-MM-DD).
    // Posting is open Monday 7:00 AM to Friday 2:40 PM Eastern. (Rules can't tell daylight saving time, so they allow
    // Monday 11:00 UTC to Friday 19:40 UTC; the game itself also stops at exactly 2:40 PM and ignores anything after it.)
    function weekStart(week) { let p = week.split('-'); return timestamp.date(int(p[0]), int(p[1]), int(p[2])); }
    function cupOpen(week) { return week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && request.time >= weekStart(week) + duration.value(11, 'h')
      && request.time < weekStart(week) + duration.value(115, 'h') + duration.value(40, 'm'); }
    function okCup(uid, week) {
      let d = request.resource.data;
      return isMe(uid) && notBanned() && cupOpen(week)
        && d.keys().hasOnly(['name', 'uid', 'hr', 'cid', 'date', 'strokes', 'rel', 'att', 't'])
        && d.uid == uid && okName(d.name)
        && d.hr in ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'J', 'K', 'L', 'M', 'N']
        && d.cid is string && d.cid.size() < 20
        && d.strokes is int && d.strokes >= 18 && d.strokes < 400
        && d.rel is int && d.rel >= -18 && d.rel < 340 && d.strokes - d.rel >= 54 && d.strokes - d.rel <= 76   // (an 18-hole par 54 to 76 course; 18 under at most)
        && d.att is int && d.att > 0 && d.att < 10000 && recent(d.date);
    }
    match /hrcup/{week}/scores/{uid} {
      allow read: if true;
      allow create: if okCup(uid, week) && request.resource.data.att == 1 && request.resource.data.t == request.time;
      // every finished cup round adds 1 attempt; the score (and its time stamp) only changes when it gets better.
      // The homeroom can't change once a golfer has posted that week.
      allow update: if okCup(uid, week) && request.resource.data.hr == resource.data.hr && request.resource.data.att == resource.data.att + 1
        && ((request.resource.data.strokes < resource.data.strokes && request.resource.data.t == request.time)
          || (request.resource.data.strokes == resource.data.strokes && request.resource.data.rel == resource.data.rel && request.resource.data.t == resource.data.t));
      allow delete: if isAdmin();
    }
    // hrcupWeeks/{week}: the final standings, saved once by the first game that opens the cup after the week locks.
    // Never changed after that (only the creator can fix or remove one).
    function cupFinal(week) { return week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && request.time > weekStart(week) + duration.value(114, 'h') + duration.value(42, 'm'); }   // (Friday 2:42 PM EDT; the game waits for 2:42 PM Eastern itself)
    match /hrcupWeeks/{week} {
      allow read: if true;
      allow create: if request.auth != null && notBanned() && cupFinal(week) && request.resource.data.week == week
        && request.resource.data.keys().hasOnly(['week', 'cid', 'course', 'par', 'winner', 'at', 'teams'])
        && request.resource.data.at == request.time && request.resource.data.teams is list && request.resource.data.teams.size() <= 13;
      allow update, delete: if isAdmin();
      match /full/{doc} {
        allow read: if true;
        allow create: if request.auth != null && notBanned() && cupFinal(week) && doc == 'players'
          && request.resource.data.keys().hasOnly(['list']) && request.resource.data.list is list;
        allow update, delete: if isAdmin();
      }
    }

    // Daily Closest to the Pin: one row per golfer per day (their closest shot, in yards).
    function okShot(uid, day) {
      let d = request.resource.data;
      return isMe(uid) && notBanned() && d.keys().hasOnly(['name', 'uid', 'yd', 'date', 'day', 't', 'badge', 'wins'])
        && d.uid == uid && okName(d.name) && okBadge(d, uid) && okWins(d)
        && d.yd is number && d.yd >= 0 && d.yd < 400
        && recent(d.date) && d.day == day && d.t == request.time;
    }
    match /ctp/{day}/shots/{uid} {
      allow read: if true;
      allow create: if okShot(uid, day);
      allow update: if okShot(uid, day) && request.resource.data.yd < resource.data.yd;
      allow delete: if isAdmin();
    }

    // Hole-in-ones today (the banner on the Play tab): ONE record per day holding a list, so the banner costs 1 read.
    // Each write can only add one ace to the end of the list, and only an ace by the golfer writing it.
    function okAce(a) {
      return a is map && a.keys().hasOnly(['name', 'uid', 'cid', 'course', 'hole', 'yds', 'date', 'badge', 'wins'])
        && a.uid == request.auth.uid && okName(a.name) && okBadge(a, request.auth.uid) && okWins(a)
        && a.course is string && a.course.size() < 40 && a.hole is int && a.yds is int && recent(a.date);
    }
    match /acesToday/{day} {
      allow read: if true;
      allow create: if notBanned() && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list.size() == 1 && okAce(request.resource.data.list[0]);
      allow update: if notBanned() && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list.size() == resource.data.list.size() + 1 && request.resource.data.list.size() <= 300
        && request.resource.data.list[0:resource.data.list.size()] == resource.data.list
        && okAce(request.resource.data.list[resource.data.list.size()]);
      allow delete: if isAdmin();
    }
    // The very first hole in one in the game's history (First Ace Ever badge). Can only be claimed once.
    match /meta/firstAce {
      allow read: if true;
      allow create: if notBanned() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    // Creator's Pick badges, handed out by the creator.
    match /gifts/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Badge counts: each golfer with a Hole in One or Daily Champion badge leaves a tiny note here (anyone can count them).
    match /badgeHolders/{bid}/who/{uid} {
      allow read: if true;
      allow create: if isMe(uid) && notBanned() && bid in ['ace', 'champ']
        && request.resource.data.keys().hasOnly(['name', 'at']) && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow delete: if isMe(uid) || isAdmin();
    }

    // One small counter doc for the badge tiles: a golfer can only add 1, and only in the same write that creates
    // their own badge note above (so each golfer counts once). The creator can fix it with "Recount badge holders".
    function bumpBadge(k) {
      let before = resource == null ? {} : resource.data;
      let keys = resource == null ? request.resource.data.keys() : request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly([k]) && request.resource.data[k] == before.get(k, 0) + 1
        && !exists(/databases/$(database)/documents/badgeHolders/$(k)/who/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/badgeHolders/$(k)/who/$(request.auth.uid));
    }
    match /meta/badgeCounts {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && notBanned() && (bumpBadge('ace') || bumpBadge('champ')));
    }

    // ---- Bans and review lists ----
    // (Oct 27 2026) The game no longer bans anyone by itself. Only the creator can ban or lift a ban.
    match /bans/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
    }
    // (The appeals collection is gone: nobody can read or write it any more.)
    // Banned golfers' IDs (written by the creator's tools), so every game hides them from all the leaderboards.
    match /meta/bannedList {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Hole-in-one logs (and the scorecards a banned golfer's game sends up), for the creator to review.
    match /flags/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'kind', 'detail', 'strong', 'google', 'at', 't', 'card', 'hard'])
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 140
        && (!('card' in request.resource.data) || (request.resource.data.card is map && request.resource.data.card.size() <= 4));
    }

    // Scorecard review: the full card of any round of -9 or better over 9 holes (-18 or better over 18). Never bans anyone.
    match /reviews/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'google', 't', 'cid', 'course', 's', 'pars', 'n', 'rel', 'strokes', 'aces', 'm', 'at'])
        && request.resource.data.s is string && request.resource.data.s.size() <= 40
        && request.resource.data.course is string && request.resource.data.course.size() <= 40
        && request.resource.data.n is int && request.resource.data.n > 0 && request.resource.data.n <= 18
        && request.resource.data.rel is int;
    }

    // (Analytics moved to Google Analytics: the old "presence" notes and "daily" counters aren't used any more.)
    // Player directory for the creator's "Find a player" search: one tiny record per golfer (name only).
    match /players/{uid} {
      allow read: if isAdmin();
      allow create, update: if (isAdmin() || (isMe(uid) && notBanned()))
        && request.resource.data.keys().hasOnly(['name', 'n', 'g', 'at'])
        && okName(request.resource.data.name) && request.resource.data.n == request.resource.data.name.lower()
        && request.resource.data.g is bool && request.resource.data.at is int;
      allow delete: if isAdmin();
    }
    // The old "last seen" notes: no longer written, but the creator can still read them (used once to fill the player list).
    match /presence/{uid} {
      allow read: if isAdmin();
    }

    // ---- Play Friends ----
    // Matches are joined with the 6-character match code. (The old friend codes and inbox are closed: nothing can read or write them.)
    // Matches (doc id = the 6-character match code). Golfers in the match can update it; the host can't be changed.
    match /matches/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.host == resource.data.host
        && (request.auth.uid in resource.data.players || request.auth.uid in request.resource.data.players);
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
    }
  }
}
